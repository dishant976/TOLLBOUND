<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TOLLBOUND • Grid • Banner • Toll</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');
    :root { --neon: #39ff14; --magenta: #ff00ff; --cyan: #00f0ff; }
    body { font-family: 'Press Start 2P', system-ui; background: #0a0a0a; color: white; }
    .neon-text { text-shadow: 0 0 10px var(--neon), 0 0 20px var(--neon); }
    .neon-green { color: #39ff14; text-shadow: 0 0 15px #39ff14; }
    .mask { filter: drop-shadow(0 0 20px #39ff14); }
    .octagon { clip-path: polygon(30% 0%, 70% 0%, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0% 70%, 0% 30%); }
    .pixel-title { font-size: 2.5rem; letter-spacing: 4px; }
    .nav-link { transition: all 0.2s; }
    .nav-link:hover { color: #39ff14; text-shadow: 0 0 10px #39ff14; }
  </style>
</head>
<body class="min-h-screen">

  <!-- NAVBAR -->
  <nav class="bg-black border-b-4 border-[#39ff14] sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-[#39ff14] rounded-full flex items-center justify-center text-black font-bold text-2xl shadow-[0_0_20px_#39ff14]">◉</div>
        <h1 class="pixel-title neon-green tracking-widest">TOLLBOUND</h1>
      </div>
      <div class="flex gap-8 text-sm uppercase font-medium">
        <a href="#grid" class="nav-link">GRID MAKER</a>
        <a href="#banner" class="nav-link">BANNER MAKER</a>
        <a href="#toll" class="nav-link">TOLL CALCULATOR</a>
        <a href="#api" class="nav-link">API</a>
      </div>
      <a href="https://opensea.io/collection/tollbound" target="_blank"
         class="px-8 py-2 border-2 border-[#39ff14] text-[#39ff14] hover:bg-[#39ff14] hover:text-black font-bold uppercase text-sm transition">OPENSEA</a>
    </div>
  </nav>

  <!-- HERO -->
  <header class="max-w-7xl mx-auto px-6 py-12 text-center border-b border-[#39ff14]/30">
    <h2 class="text-6xl font-bold neon-green pixel-title mb-4">PAY THE TOLL.<br>STAY BOUND.</h2>
    <p class="text-lg text-[#ff00ff] max-w-md mx-auto">Fully on-chain doodle masks • Burn to evolve • Ruled by fate</p>
    <a href="https://x.com/beastoshii" target="_blank" class="inline-flex items-center gap-2 mt-8 px-6 py-3 border border-[#ff00ff] text-[#ff00ff] hover:bg-[#ff00ff] hover:text-black text-sm uppercase">#TOLLBOUND</a>
  </header>

  <!-- GRID MAKER -->
  <section id="grid" class="max-w-7xl mx-auto px-6 py-16 bg-black/70">
    <h2 class="text-5xl neon-green pixel-title mb-8 text-center">NFT GRID MAKER</h2>
    
    <div class="grid md:grid-cols-12 gap-8">
      <!-- LEFT PANEL -->
      <div class="md:col-span-3 bg-zinc-950 border-2 border-[#ff00ff] p-8">
        <h3 class="uppercase text-[#39ff14] mb-6 text-sm">CREATE YOUR GRID</h3>
        
        <div class="space-y-8">
          <div>
            <label class="block text-xs mb-2 text-gray-400">Token IDs (comma separated)</label>
            <input id="tokenIds" type="text" value="4208, 1337, 6969, 8888, 4212" 
                   class="w-full bg-black border-2 border-gray-600 p-4 text-[#39ff14] font-mono focus:border-[#39ff14] outline-none text-sm">
            <p class="text-[10px] mt-2 text-gray-500">Real on-chain SVGs • Any token ID</p>
          </div>

          <div>
            <label class="block text-xs mb-2 text-gray-400">Grid columns</label>
            <select id="gridCols" class="w-full bg-black border-2 border-gray-600 p-4 text-white focus:border-[#39ff14]">
              <option value="3">3 columns</option>
              <option value="4" selected>4 columns</option>
              <option value="5">5 columns</option>
            </select>
          </div>

          <button onclick="generateRealGrid()" 
                  class="w-full py-6 bg-[#39ff14] text-black uppercase font-bold text-lg tracking-widest hover:scale-105 transition">GENERATE GRID</button>
        </div>
      </div>

      <!-- PREVIEW -->
      <div class="md:col-span-9">
        <div id="gridPreview" class="min-h-[500px] border-4 border-dashed border-[#39ff14] bg-zinc-950 p-8 grid grid-cols-4 gap-6">
          <!-- Real images injected here -->
        </div>

        <div class="flex gap-4 mt-6">
          <button onclick="downloadGrid()" 
                  class="flex-1 py-5 border-2 border-[#39ff14] text-[#39ff14] uppercase font-bold flex items-center justify-center gap-3 hover:bg-[#39ff14] hover:text-black transition">
            <i class="fas fa-download"></i> DOWNLOAD GRID PNG
          </button>
          <button onclick="clearGrid()" 
                  class="flex-1 py-5 border-2 border-[#ff00ff] text-[#ff00ff] uppercase font-bold hover:bg-[#ff00ff] hover:text-black transition">CLEAR GRID</button>
        </div>
      </div>
    </div>
  </section>

  <!-- TOLL CALCULATOR - NOW COMPACT & SMALL -->
  <section id="toll" class="max-w-7xl mx-auto px-6 py-12 bg-black">
    <div class="max-w-md mx-auto bg-zinc-950 border-2 border-[#39ff14] p-6 rounded-none">
      <h2 class="text-3xl neon-green pixel-title mb-4 text-center">TOLL CALCULATOR</h2>
      <p class="text-center text-xs text-gray-400 mb-4">1 burn = Toll 1 • Burn to evolve</p>
      
      <input id="burnsInput" type="range" min="0" max="10" value="3" 
             class="w-full accent-[#39ff14] mb-4">
      
      <div class="text-center">
        <div id="tollNumber" class="text-5xl font-bold text-[#39ff14] mb-1">3</div>
        <div class="text-sm text-[#ff00ff] tracking-widest">TOLL LEVEL</div>
        <div id="stageText" class="mt-3 text-base text-cyan-400 font-medium"></div>
      </div>
    </div>
  </section>

  <!-- BANNER MAKER -->
  <section id="banner" class="max-w-7xl mx-auto px-6 py-16 bg-black/70">
    <h2 class="text-5xl neon-green pixel-title mb-8">BANNER MAKER</h2>
    <div class="border-4 border-[#00f0ff] bg-gradient-to-r from-[#0a0a0a] to-[#1a0033] p-8 rounded-none">
      <div id="bannerCanvas" class="relative w-full aspect-video bg-black flex items-center justify-center overflow-hidden border-2 border-[#00f0ff]">
        <div class="text-center">
          <h1 id="bannerTitle" class="text-7xl neon-green pixel-title">YOUR TOLLBOUND BANNER</h1>
          <p id="bannerSubtitle" class="text-2xl text-[#ff00ff] mt-4">PAY THE TOLL • STAY BOUND</p>
        </div>
      </div>
      <div class="mt-6 flex gap-4">
        <input id="bannerText" type="text" value="I AM #TOLLBOUND" 
               class="flex-1 bg-black border-2 border-[#00f0ff] p-6 text-white text-xl">
        <button onclick="updateBanner()" class="px-12 py-6 bg-[#ff00ff] text-black uppercase font-bold">UPDATE</button>
        <button onclick="downloadBanner()" class="px-12 py-6 border-2 border-white text-white uppercase font-bold">DOWNLOAD BANNER PNG</button>
      </div>
    </div>
  </section>

  <!-- API SECTION -->
  <section id="api" class="max-w-7xl mx-auto px-6 py-16">
    <h2 class="text-5xl neon-green pixel-title mb-8">HOW TO FETCH API</h2>
    <div class="grid md:grid-cols-2 gap-10">
      <div class="bg-black border-2 border-[#39ff14] p-8">
        <pre class="text-xs text-[#00f0ff] overflow-auto bg-zinc-900 p-6"><code>fetch("https://api.opensea.io/api/v2/chain/ethereum/contract/0x53792b8a1e2baf9c1b37cdf3e7789d7ee65724ac/nfts/4208")
  .then(r => r.json())
  .then(data => console.log(data.nft.image_url))</code></pre>
      </div>
      <div class="text-sm space-y-4">
        <p><strong class="text-[#39ff14]">Contract:</strong> 0x53792b8a1e2baf9c1b37cdf3e7789d7ee65724ac</p>
        <p class="text-gray-400">Fully on-chain SVGs • Real images load instantly in Grid Maker</p>
      </div>
    </div>
  </section>

  <footer class="text-center py-12 text-xs text-gray-500 border-t border-[#39ff14]/30">
    Final version • Built for @beastoshii #TOLLBOUND • 
    <a href="https://github.com" class="underline">Upload to GitHub → enable Pages</a>
  </footer>

  <script>
    // Tailwind
    function init() {
      tailwind.config = { content: ["*"] }
    }

    // === REAL GRID MAKER ===
    window.generateRealGrid = async function () {
      const input = document.getElementById('tokenIds').value.trim()
      if (!input) return alert('Enter token IDs!')
      
      const preview = document.getElementById('gridPreview')
      preview.innerHTML = `<div class="col-span-full flex flex-col items-center justify-center h-96 text-[#39ff14]">
        <i class="fas fa-spinner animate-spin text-6xl mb-6"></i>
        <p class="text-xl">Fetching real TOLLBOUND masks...</p>
      </div>`

      const ids = input.split(',').map(i => i.trim()).filter(Boolean)
      const contract = "0x53792b8a1e2baf9c1b37cdf3e7789d7ee65724ac"
      const cols = document.getElementById('gridCols').value

      const promises = ids.map(async id => {
        try {
          const res = await fetch(`https://api.opensea.io/api/v2/chain/ethereum/contract/${contract}/nfts/${id}`, {
            headers: { 'Accept': 'application/json' }
          })
          const data = await res.json()
          return { id: id, image: data.nft?.image_url || `https://placehold.co/600x600/111/39ff14?text=TOLL%23${id}` }
        } catch {
          return { id: id, image: `https://placehold.co/600x600/111/39ff14?text=ERROR%23${id}` }
        }
      })

      const results = await Promise.all(promises)

      preview.style.gridTemplateColumns = `repeat(${cols}, minmax(0, 1fr))`
      preview.innerHTML = ''

      results.forEach(({ id, image }) => {
        const div = document.createElement('div')
        div.className = `aspect-square bg-black border-2 border-[#ff00ff]/60 flex items-center justify-center p-4 octagon relative overflow-hidden hover:scale-110 transition`
        div.innerHTML = `
          <img src="${image}" alt="TOLL #${id}" class="w-full h-full object-contain mask">
          <div class="absolute bottom-3 left-3 bg-black/80 text-[#39ff14] text-xs px-3 py-1 font-mono">TOLL #${id}</div>
        `
        preview.appendChild(div)
      })
    }

    // WATERMARK FUNCTION
    function addWatermark(canvas) {
      const ctx = canvas.getContext('2d')
      ctx.save()
      
      // Neon green watermark
      ctx.shadowColor = '#39ff14'
      ctx.shadowBlur = 12
      ctx.fillStyle = '#39ff14'
      ctx.font = 'bold 32px "Press Start 2P", monospace'
      ctx.textAlign = 'center'
      ctx.textBaseline = 'middle'
      
      const text = 'I AM TOLLBOUND'
      const x = canvas.width / 2
      const y = canvas.height - 50
      
      ctx.fillText(text, x, y)
      ctx.restore()
      return canvas
    }

    // DOWNLOAD GRID WITH WATERMARK
    window.downloadGrid = function () {
      const preview = document.getElementById('gridPreview')
      html2canvas(preview, { scale: 2, backgroundColor: '#111111' }).then(canvas => {
        const watermarked = addWatermark(canvas)
        const link = document.createElement('a')
        link.download = 'tollbound-grid.png'
        link.href = watermarked.toDataURL('image/png')
        link.click()
      })
    }

    window.clearGrid = function () {
      document.getElementById('gridPreview').innerHTML = ''
    }

    // BANNER MAKER
    window.updateBanner = function () {
      const text = document.getElementById('bannerText').value || 'I AM #TOLLBOUND'
      document.getElementById('bannerTitle').textContent = text.toUpperCase()
    }

    // DOWNLOAD BANNER WITH WATERMARK
    window.downloadBanner = function () {
      const canvasEl = document.getElementById('bannerCanvas')
      html2canvas(canvasEl, { scale: 2 }).then(canvas => {
        const watermarked = addWatermark(canvas)
        const link = document.createElement('a')
        link.download = 'tollbound-banner.png'
        link.href = watermarked.toDataURL('image/png')
        link.click()
      })
    }

    // TOLL CALCULATOR (compact)
    const slider = document.getElementById('burnsInput')
    function updateToll() {
      const burns = parseInt(slider.value)
      document.getElementById('tollNumber').textContent = burns
      let stage = ''
      if (burns === 0) stage = 'RAW SOUL — STAGE 0'
      else if (burns === 1) stage = 'GATE MARKED — STAGE 1'
      else if (burns === 2) stage = 'ORACLE WITNESS — STAGE 2'
      else if (burns === 3) stage = 'ASCENDED — STAGE 3'
      else stage = 'THE UNBOUND 🔥 — STAGE 4+'
      document.getElementById('stageText').innerHTML = `<span class="text-[#00f0ff]">${stage}</span>`
    }
    slider.addEventListener('input', updateToll)

    // INIT
    window.onload = function () {
      init()
      updateToll()
      setTimeout(() => {
        generateRealGrid()
      }, 600)
    }
  </script>
</body>
</html>
